{
  "name": "c-mind",
  "productName": "C-Mind",
  "version": "0.1.0",
  "private": true,
  "description": "C-Mind 心图 — 本地优先的 macOS 脑图客户端",
  "author": "Chris",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "icon": "node scripts/gen-icon.mjs && bash scripts/make-icns.sh",
    "dist": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "simple-git": "^4.0.2",
    "simple-mind-map": "0.14.0-fix.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
